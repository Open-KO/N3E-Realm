#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
source tools/env.sh
make client
python tools/assetc/npc_fixture.py "$@"
bash deploy/local-ca.sh
export N3E_UID="$(id -u)" N3E_GID="$(id -g)"
export N3E_PACKAGE_PATH="$PWD/build/packages/npc" N3E_REALM=npc N3E_PORT=7787
npc_project=n3e-npc
if [[ "${1:-}" == "--ko" ]]; then
  export N3E_PACKAGE_PATH="$PWD/build/packages/npc-ko" N3E_REALM=npc-ko N3E_PORT=7788
  npc_project=n3e-npc-ko
fi
docker compose -p "$npc_project" up --build -d --wait --force-recreate server
exec python tools/play_movement.py --npc "$@"
