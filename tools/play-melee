#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
source tools/env.sh
make client
python tools/assetc/melee_fixture.py "$@"
bash deploy/local-ca.sh
export N3E_UID="$(id -u)" N3E_GID="$(id -g)"
export N3E_PACKAGE_PATH="$PWD/build/packages/melee" N3E_REALM=melee N3E_PORT=7783
melee_project=n3e-melee
if [[ "${1:-}" == "--ko" ]]; then
  export N3E_PACKAGE_PATH="$PWD/build/packages/melee-ko" N3E_REALM=melee-ko N3E_PORT=7784
  melee_project=n3e-melee-ko
fi
docker compose -p "$melee_project" up --build -d --wait --force-recreate server
exec python tools/play_movement.py --melee "$@"
