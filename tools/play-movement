#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
source tools/env.sh
make client
python tools/assetc/movement_fixture.py "$@"
bash deploy/local-ca.sh
export N3E_UID="$(id -u)" N3E_GID="$(id -g)"
export N3E_PACKAGE_PATH="$PWD/build/packages/movement" N3E_REALM=movement N3E_PORT=7779
movement_project=n3e-movement
if [[ "${1:-}" == "--ko" ]]; then
  export N3E_PACKAGE_PATH="$PWD/build/packages/movement-ko" N3E_REALM=movement-ko N3E_PORT=7780
  movement_project=n3e-movement-ko
fi
docker compose -p "$movement_project" up --build -d --wait --force-recreate server
exec python tools/play_movement.py "$@"
