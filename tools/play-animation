#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
source tools/env.sh
make client
python tools/assetc/animation_fixture.py "$@"
bash deploy/local-ca.sh
export N3E_UID="$(id -u)" N3E_GID="$(id -g)"
export N3E_PACKAGE_PATH="$PWD/build/packages/animation" N3E_REALM=animation N3E_PORT=7791
animation_project=n3e-animation
if [[ "${1:-}" == "--ko" ]]; then
  export N3E_PACKAGE_PATH="$PWD/build/packages/animation-ko" N3E_REALM=animation-ko N3E_PORT=7792
  animation_project=n3e-animation-ko
fi
docker compose -p "$animation_project" up --build -d --wait --force-recreate server
exec python tools/play_movement.py --animation "$@"
