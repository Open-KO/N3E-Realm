{
  "character_slots": 3,
  "fonts": {
    "regular": "/usr/share/fonts/liberation/LiberationSans-Regular.ttf",
    "bold": "/usr/share/fonts/liberation/LiberationSans-Bold.ttf"
  },
  "screens": {
    "login": {
      "ui": "UI_US/co_login_us.uif",
      "place": "bottom",
      "moves": [{"node": "Group_ServerList", "x": 0, "y": 0}],
      "bindings": {
        "Group_LogIn": "login_group",
        "Group_ServerList": "realm_group",
        "List_Server": "realm_list",
        "Btn_Connect": "realm_connect",
        "Btn_Login": "login",
        "Btn_Cancel": "exit"
      },
      "hidden": ["Img_Daum", "Img_MGame", "premium", "Group_Notice_1", "Group_Notice_2", "Group_Notice_3"]
    },
    "select": {
      "ui": "UI_US/ka_characterselect_us.uif",
      "place": "origin",
      "moves": [
        {"node": "bt_left", "bottom": 10},
        {"node": "bt_right", "bottom": 10},
        {"node": "bt_exit", "bottom": 10},
        {"node": "bt_back", "above": ["bt_exit", 15]}
      ],
      "bindings": {
        "text00": "char_info",
        "bt_left": "select_prev",
        "bt_right": "select_next",
        "bt_back": "back",
        "bt_exit": "exit"
      },
      "hidden": ["bt_delete"]
    },
    "create": {
      "ui": "UI_US/Ka_CharacterCreate_us.uif",
      "place": "centre",
      "bindings": {
        "btn_create": "create_confirm",
        "btn_cancel": "back",
        "edit_name": "name_field",
        "area_character": "char_view",
        "text_desc": "class_desc"
      },
      "states": {
        "btn_race_ka_tu": "on",
        "btn_class_priest": "on",
        "btn_race_ka_at": "disabled",
        "btn_race_ka_wt": "disabled",
        "btn_race_ka_pt": "disabled",
        "btn_class_warrior": "disabled",
        "btn_class_rogue": "disabled",
        "btn_class_mage": "disabled",
        "btn_face_left": "disabled",
        "btn_face_right": "disabled",
        "btn_hair_left": "disabled",
        "btn_hair_right": "disabled",
        "btn_str_left": "disabled",
        "btn_str_right": "disabled",
        "btn_sta_left": "disabled",
        "btn_sta_right": "disabled",
        "btn_dex_left": "disabled",
        "btn_dex_right": "disabled",
        "btn_int_left": "disabled",
        "btn_int_right": "disabled",
        "btn_map_left": "disabled",
        "btn_map_right": "disabled"
      },
      "hidden": [
        "img_warrior", "img_rogue", "img_mage",
        "img_str", "img_sta", "img_dex", "img_int", "img_map", "text_bonus"
      ]
    },
    "loading": {
      "ui": "UI_US/ka_loading_us.uif",
      "place": "centre",
      "moves": [{"node": "Text_Version", "x": 10, "y": 10}],
      "bindings": {
        "Progress_Loading": "progress",
        "Text_Version": "version",
        "Text_Info": "info"
      }
    },
    "message": {
      "ui": "UI_US/co_MsgBoxOk_us.uif",
      "place": "centre",
      "bindings": {"text_msg": "message", "btn_ok": "ok"}
    }
  },
  "strings": {
    "select_info": "Level: {level}\nSpecialty: {class}\nID: {name}",
    "select_hint": "Press ENTER to create a character.",
    "class_name": "Priest",
    "class_desc": "Priests heal and shield their party and fight with a mace. Every character in this realm is a Tuarek priest.",
    "loading_info": "Loading...",
    "version": "Ver. {version}"
  },
