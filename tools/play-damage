#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
source tools/env.sh
make client
python tools/assetc/damage_fixture.py "$@"
bash deploy/local-ca.sh
export N3E_UID="$(id -u)" N3E_GID="$(id -g)"
export N3E_PACKAGE_PATH="$PWD/build/packages/damage" N3E_REALM=damage N3E_PORT=7785
damage_project=n3e-damage
if [[ "${1:-}" == "--ko" ]]; then
  export N3E_PACKAGE_PATH="$PWD/build/packages/damage-ko" N3E_REALM=damage-ko N3E_PORT=7786
  damage_project=n3e-damage-ko
fi
docker compose -p "$damage_project" up --build -d --wait --force-recreate server
exec python tools/play_movement.py --damage "$@"
